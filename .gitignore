# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archify visual-check 스크린샷 (영수증 JSON·HTML 은 커밋한다)
docs/flow/**/*.visual-check.*.png
.playwright-mcp/

# 데모 빌드 중 잠시 치운 실제 앱(scripts/build-demo.mjs)
/.demo-aside/
