# whale-erp-api 주소. 로컬 api 는 PORT 기본 8000.
API_BASE_URL=http://localhost:8000

# Next 앞에서 X-Forwarded-For 에 접속 주소를 덧붙이는 프록시(로드밸런서) 수. 직원의 실제 접속 IP 를
# 오른쪽에서 이만큼 센 항목으로 골라 api 에 X-Forwarded-For 로 넘긴다(api 요청 제한, api PR #10).
# 0 은 Next 가 바로 접속을 받는 로컬 개발용 — 클라이언트가 헤더를 지어낼 수 있어 운영(NODE_ENV=production)에서는
# 비었거나 0 이면 서버가 뜨지 않는다. 인프라 구성대로 1 이상을 정한다.
TRUSTED_PROXY_HOPS=0

# 출퇴근 화면 지도(카카오 지도 JavaScript 키). 카카오 디벨로퍼스 앱의 Web 플랫폼에 등록한 도메인에서만 동작한다.
# 서버가 요청 때 읽어 화면에 넘긴다(배포 때 마운트하는 값 파일에 넣으면 된다). 비우면 지도 대신 그림이나 빈 지도 자리를 보인다. 도메인을 등록하지 않으면 SDK 가 막혀 조용히 그림으로 바뀌므로, 배포 뒤 출퇴근 탭에서 지도가 뜨는지 확인한다.
KAKAO_MAP_APP_KEY=
